#!/usr/bin/env python3
"""Native GTK board window for Forge on Linux/Omarchy."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

if any(arg in {"-h", "--help", "--version"} for arg in sys.argv[1:]):
    parser = argparse.ArgumentParser(description="Open the Forge kanban board window")
    parser.add_argument("--forge-home", help="Forge home directory")
    parser.add_argument("--version", action="version", version="Forge GTK board 0.1")
    parser.parse_args()

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

SCRIPT_DIR = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SCRIPT_DIR))
from forge_board_model import BoardProject, BoardSnapshot, ForgeBoardClient  # noqa: E402


class BoardWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application, client: ForgeBoardClient) -> None:
        super().__init__(application=app, title="Forge")
        self.set_default_size(1240, 760)
        self.client = client
        self._snapshot: BoardSnapshot | None = None

        header = Adw.HeaderBar()
        header.set_title_widget(Gtk.Label(label="Forge"))
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh board")
        refresh.connect("clicked", lambda *_: self.refresh())
        header.pack_end(refresh)

        self.status = Gtk.Label(xalign=0)
        self.status.add_css_class("dim-label")
        self.status.set_margin_start(18)
        self.status.set_margin_top(8)
        self.status.set_margin_bottom(8)

        self.board = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.board.set_margin_start(12)
        self.board.set_margin_end(12)
        self.board.set_margin_bottom(12)
        self.board.set_hexpand(True)
        self.board.set_vexpand(True)
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.AUTOMATIC,
                                    vscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
        scroll.set_child(self.board)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(header)
        root.append(self.status)
        root.append(scroll)
        self.set_content(root)
        self.refresh()

    def refresh(self) -> None:
        self.status.set_text("Refreshing…")
        try:
            self._snapshot = self.client.refresh()
            self._render(self._snapshot)
        except Exception as exc:  # keep the window open and actionable
            self.status.set_text(f"Could not refresh Forge: {exc}")

    def _render(self, snapshot: BoardSnapshot) -> None:
        while child := self.board.get_first_child():
            self.board.remove(child)
        grouped = snapshot.by_column
        for column in snapshot.columns:
            frame = Gtk.Frame()
            frame.set_size_request(170, -1)
            title = Gtk.Label(label=f"{column.name}  {len(grouped.get(column.name, ())) }")
            title.add_css_class("heading")
            title.set_margin_top(10)
            title.set_margin_bottom(8)
            title.set_margin_start(10)
            title.set_xalign(0)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
            box.append(title)
            for project in grouped.get(column.name, ()):
                box.append(self._card(project))
            box.set_margin_start(8)
            box.set_margin_end(8)
            box.set_margin_bottom(8)
            frame.set_child(box)
            self.board.append(frame)
        sp = f"SP: {snapshot.sp_open_tasks} open tasks · {snapshot.sp_inbox} inbox"
        if snapshot.sp_error:
            sp += f" · {snapshot.sp_error}"
        calendar = snapshot.calendar_error or "calendar connected"
        self.status.set_text(f"{len(snapshot.projects)} projects · {sp} · Calendar: {calendar}")

    def _card(self, project: BoardProject) -> Gtk.Widget:
        button = Gtk.Button()
        button.set_hexpand(True)
        button.set_halign(Gtk.Align.FILL)
        button.add_css_class("card")
        label = Gtk.Label(label=project.name, wrap=True, xalign=0)
        if project.urgent:
            label.set_text(f"⚠️ {project.name}")
        label.set_margin_top(7)
        label.set_margin_bottom(7)
        label.set_margin_start(7)
        label.set_margin_end(7)
        button.set_child(label)
        button.connect("clicked", lambda *_: self._open_project(project))
        return button

    def _open_project(self, project: BoardProject) -> None:
        if project.path:
            subprocess.Popen(["xdg-open", project.path])


class ForgeBoardApp(Adw.Application):
    def __init__(self, forge_home: str | None = None) -> None:
        super().__init__(application_id="io.github.simonab.Forge", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        home = Path(forge_home).expanduser() if forge_home else None
        self.client = ForgeBoardClient(forge_home=home)

    def do_activate(self) -> None:
        window = self.props.active_window
        if window is None:
            window = BoardWindow(self, self.client)
        window.present()


def main() -> int:
    parser = argparse.ArgumentParser(description="Open the Forge kanban board window")
    parser.add_argument("--forge-home")
    args = parser.parse_args()
    return ForgeBoardApp(args.forge_home).run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
