# Local upstream fork / PR work (not part of this repo)
_upstream/

# Sparkle release tarball extract (local tooling; see packaging docs)
packaging/sparkle-*-dist/

# Build artefacts
.build
.build*

# Swift Package Manager
.swiftpm/
.swiftpm/xcode/xcuserdata/

# macOS
.DS_Store
*.xcuserstate

# Xcode (if used)
DerivedData/
*.xcworkspace/xcuserdata/

# Python (generate_icon, import scripts)
__pycache__/
*.pyc
.pycache/

# Editors / IDE
.cursor/*
!.cursor/hooks.json
!.cursor/rules/
!.cursor/rules/**
.focus

# Release/distribution artefacts
dist-app/

# Task files and caches (workspace-specific, may contain private data)
tasks/
.cache/

# Local configuration (contains machine- and person-specific paths/projects)
config.yaml
config.real.yaml

# Personal templates (local copies; not part of upstream source)
templates/
